{
  "name": "@vuyro/engine",
  "version": "0.0.0",
  "description": "Vuyro workflow engine",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
