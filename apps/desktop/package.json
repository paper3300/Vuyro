{
  "name": "@vuyro/desktop",
  "version": "0.0.0",
  "description": "Vuyro desktop app (Electron main, preload and UI)",
  "private": true,
  "type": "module",
  "main": "./dist/main/main.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "electron ."
  },
  "dependencies": {
    "@vuyro/cli": "workspace:*",
    "@vuyro/contracts": "workspace:*",
    "@vuyro/engine": "workspace:*"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@xyflow/react": "12.12.0",
    "electron": "^45.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "zustand": "5.0.15"
  },
  "files": [
    "dist",
    "static"
  ]
}
